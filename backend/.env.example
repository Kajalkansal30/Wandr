# Backend env template — copy to backend/.env (gitignored) and fill real values.
# Spring loads backend/.env automatically on startup.

# DATABASE_URL=postgresql://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres

CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

WANDR_JWT_SECRET=wandr-dev-secret-change-me-in-production-32chars-min
WANDR_CORS_ORIGINS=http://localhost:*,http://127.0.0.1:*

# Email (Resend) — leave blank in dev to log emails to console instead of sending
RESEND_API_KEY=

# Public web app URL for verification/reset links (required in prod)
WANDR_WEB_BASE_URL=http://localhost:5173

# Production (Render): set SPRING_PROFILES_ACTIVE=prod, WANDR_JWT_SECRET (32+ chars),
# RESEND_API_KEY, WANDR_WEB_BASE_URL=https://www.wandrhere.com, and WANDR_CORS_ORIGINS.
