# Backend env template — copy to backend/.env (gitignored) and fill real values.
# Spring loads backend/.env automatically on startup.

# DATABASE_URL=postgresql://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres

CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

WANDR_JWT_SECRET=wandr-dev-secret-change-me-in-production-32chars-min
WANDR_CORS_ORIGINS=http://localhost:*,http://127.0.0.1:*
