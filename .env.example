# Spring Boot API (default if unset)
VITE_API_URL=http://localhost:8080

# Cloudinary — public values only (copy to .env and fill).
# Cloud name is NOT the API key name (e.g. "Wandr"). Find it on the Cloudinary dashboard.
# API secret stays on Spring only.

VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name
VITE_CLOUDINARY_API_KEY=your_api_key

# Optional frontend error tracking (Render: VITE_SENTRY_DSN)
# VITE_SENTRY_DSN=
